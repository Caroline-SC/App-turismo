{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "App.js",
    "components/**/*.js",
    "context/**/*.js",
    "services/**/*.js",
    "screens/**/*.js",
    "src/**/*.js",
    "types/**/*.d.ts",
    "hooks/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
