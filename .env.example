# Celular físico: IP do computador na mesma rede Wi-Fi.
# Navegador: use o mesmo hostname para frontend e API (cookies de sessão).
EXPO_PUBLIC_API_URL=auto
# auto: usa o host do Expo em LAN; no navegador, usa o hostname da página.
# Para um backend remoto, substitua auto por sua URL HTTPS.
# Emulador Android: http://10.0.2.2:5000
# Navegador no computador: http://localhost:5000
